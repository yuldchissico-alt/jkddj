-- ============================================================
-- 5. ATUALIZAR TABELA FACEBOOK_ACCOUNTS
-- ============================================================

DO $$ 
BEGIN
    IF NOT EXISTS (
        SELECT 1 FROM information_schema.columns 
        WHERE table_name = 'facebook_accounts' 
        AND column_name = 'company_id'
    ) THEN
        ALTER TABLE facebook_accounts ADD COLUMN company_id INTEGER NULL;
