-- ============================================================
-- 11. VERIFICAÇÃO FINAL
-- ============================================================

DO $$
DECLARE
    table_count INTEGER;
    admin_count INTEGER;
    company_count INTEGER;
    transaction_count INTEGER;
BEGIN
    -- Contar tabelas
    SELECT COUNT(*) INTO table_count
    FROM information_schema.tables
    WHERE table_schema = 'public'
    AND table_type = 'BASE TABLE';
    
    -- Contar admins
    SELECT COUNT(*) INTO admin_count FROM admins;
    
    -- Contar empresas (company_id distintos)
    SELECT COUNT(DISTINCT company_id) INTO company_count 
    FROM admins WHERE company_id IS NOT NULL;
    
    -- Contar transações
    SELECT COUNT(*) INTO transaction_count FROM transactions;
    
    RAISE NOTICE '';
    RAISE NOTICE '============================================================';
    RAISE NOTICE '🎉 MIGRAÇÃO CONCLUÍDA COM SUCESSO!';
    RAISE NOTICE '============================================================';
    RAISE NOTICE '📊 Estatísticas:';
    RAISE NOTICE '   • Tabelas no banco: %', table_count;
    RAISE NOTICE '   • Usuários cadastrados: %', admin_count;
    RAISE NOTICE '   • Empresas ativas: %', company_count;
    RAISE NOTICE '   • Transações registradas: %', transaction_count;
    RAISE NOTICE '';
    RAISE NOTICE '🔐 LOGIN SUPER ADMIN:';
    RAISE NOTICE '   Email: admin@nexuscale.com';
    RAISE NOTICE '   Senha: admin123';
    RAISE NOTICE '   ⚠️  TROCAR SENHA IMEDIATAMENTE!';
    RAISE NOTICE '';
    RAISE NOTICE '🚀 ENDPOINTS DISPONÍVEIS:';
    RAISE NOTICE '   GET    /api/superadmin/companies';
    RAISE NOTICE '   GET    /api/superadmin/stats';
    RAISE NOTICE '   PATCH  /api/superadmin/companies/:id/status';
    RAISE NOTICE '';
    RAISE NOTICE '📖 Documentação: SAAS-MODEL.md';
    RAISE NOTICE '============================================================';
END $$;

-- Mostrar estrutura das tabelas principais
SELECT 
    'admins' as tabela,
    column_name as coluna,
    data_type as tipo,
    is_nullable as nullable
FROM information_schema.columns
WHERE table_name = 'admins'
AND column_name IN ('id', 'company_id', 'email', 'role', 'is_active')
ORDER BY ordinal_position;
